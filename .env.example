# Copy to .env and fill in real values. Never commit .env itself.
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=
OPENAI_API_KEY=

# Subscriber storage (server-side only — never expose SERVICE_ROLE_KEY to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Not decided/wired yet — needed to actually send confirmation/daily-digest
# emails once an email provider (e.g. Resend, SendGrid) is chosen.

# Optional: protects /api/cron/daily-digest from being triggered by anyone
# who finds the URL. Vercel sends this automatically for its own Cron
# invocations once set; generate any random string.
CRON_SECRET=

# Mirrors each subscribe submission (email + date) to a Google Sheet.
# Needs a Google Cloud service account with the Sheets API enabled, and that
# service account's email must be shared as an Editor on the target sheet.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY: paste the "private_key" value from the
# downloaded JSON key file as-is (keep the literal \n sequences).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional: defaults to "Sheet1!A:B" — change if your tab has a different name.
GOOGLE_SHEETS_RANGE=
